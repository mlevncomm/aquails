# Vite frontend env (NOT Next.js — do not use NEXT_PUBLIC_*)
# Supabase Dashboard → Settings → API:
#   Project URL  → VITE_SUPABASE_URL
#   anon/public key → VITE_SUPABASE_ANON_KEY

# Local development (hosted Supabase project)
VITE_SUPABASE_URL=https://tsbiicekqgxjokhyxria.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_DATA_PROVIDER=supabase
VITE_APP_URL=http://localhost:3000

# Local Supabase CLI alternative:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<local-anon-key-from-supabase-start>

# Legacy Express parallel mode only (do not set on Vercel when using Supabase)
# VITE_API_URL=http://localhost:4000

# Edge Function secrets: set via `supabase secrets set` (never in Vercel or frontend)
# APP_URL=https://your-production-domain.com
